{
	"manifest_version": 3,
	"name": "Amaranth Tweaks",
	"version": "1.1.1",
	"description": "Usability tweaks for the Okestro groupware: bigger detail popups, a check-in time badge, and a login that survives restarts.",
	"browser_specific_settings": {
		"gecko": {
			"id": "amaranth-tweaks@coffeevore",
			"strict_min_version": "142.0",
			"data_collection_permissions": {
				"required": ["none"]
			}
		}
	},
	"content_scripts": [
		{
			"matches": ["https://gw.okestro.com/*"],
			"js": ["content.js"],
			"run_at": "document_idle"
		}
	]
}
